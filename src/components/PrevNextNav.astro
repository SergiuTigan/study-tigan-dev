---
interface Props {
  prev?: { href: string; label: string };
  next?: { href: string; label: string };
}

const { prev, next } = Astro.props;
---

<div class="flex items-center justify-between mt-12 pt-6 border-t border-zinc-800">
  {
    prev ? (
      <a
        href={prev.href}
        class="flex items-center gap-2 text-sm text-zinc-400 hover:text-indigo-400 transition-colors"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15 19l-7-7 7-7"
          />
        </svg>
        <span class="truncate max-w-[200px]">{prev.label}</span>
      </a>
    ) : (
      <div />
    )
  }
  {
    next ? (
      <a
        href={next.href}
        class="flex items-center gap-2 text-sm text-zinc-400 hover:text-indigo-400 transition-colors"
      >
        <span class="truncate max-w-[200px]">{next.label}</span>
        <svg
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M9 5l7 7-7 7"
          />
        </svg>
      </a>
    ) : (
      <div />
    )
  }
</div>
