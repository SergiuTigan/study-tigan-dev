---
interface Props {
  href: string;
  title: string;
  description: string;
  count: number;
  countLabel: string;
  color: string; // e.g. "indigo", "emerald", "purple", "amber"
  icon: string; // SVG path
}

const { href, title, description, count, countLabel, color, icon } = Astro.props;

const colorMap: Record<string, { bg: string; text: string; border: string }> = {
  indigo: { bg: "bg-indigo-500/5", text: "text-indigo-400", border: "border-indigo-500/20" },
  emerald: { bg: "bg-emerald-500/5", text: "text-emerald-400", border: "border-emerald-500/20" },
  purple: { bg: "bg-purple-500/5", text: "text-purple-400", border: "border-purple-500/20" },
  amber: { bg: "bg-amber-500/5", text: "text-amber-400", border: "border-amber-500/20" },
  blue: { bg: "bg-blue-500/5", text: "text-blue-400", border: "border-blue-500/20" },
};

const c = colorMap[color] || colorMap.indigo;
---

<a
  href={href}
  class={`group block rounded-xl border ${c.border} ${c.bg} p-5 hover:border-zinc-700 transition-all hover:scale-[1.01]`}
>
  <div class="flex items-start justify-between mb-3">
    <div class={`w-9 h-9 rounded-lg ${c.bg} flex items-center justify-center`}>
      <svg
        class={`w-5 h-5 ${c.text}`}
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d={icon}></path>
      </svg>
    </div>
    <span class="text-xs text-zinc-600 font-mono">{count} {countLabel}</span>
  </div>
  <h3 class="text-sm font-semibold text-zinc-200 group-hover:text-white transition-colors">
    {title}
  </h3>
  <p class="text-xs text-zinc-500 mt-1">{description}</p>
</a>
