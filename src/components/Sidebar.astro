---
import { getCollection } from "astro:content";
import NavLink from "./NavLink.astro";
import { SidebarLesson, ModuleProgress, ClearButton } from "./ProgressTracker";

const pathname = Astro.url.pathname;

// ── Load courses for sidebar nav ─────────────────────────────────────
const allCourseLessons = await getCollection("courses");

// Detect which course is active (if any)
const courseMatch = pathname.match(/^\/courses\/([^/]+)/);
const activeCourseId = courseMatch?.[1] || null;

// Build course structure
interface CourseModule {
  id: string;
  title: string;
  order: number;
  lessons: { id: string; lessonId: string; title: string; href: string; order: number }[];
}

interface CourseInfo {
  id: string;
  title: string;
  color: string;
  modules: CourseModule[];
}

const courseMap = new Map<string, CourseInfo>();
for (const entry of allCourseLessons) {
  const cId = entry.data.course;
  if (!courseMap.has(cId)) {
    courseMap.set(cId, {
      id: cId,
      title: entry.data.courseTitle,
      color: entry.data.color,
      modules: [],
    });
  }
  const course = courseMap.get(cId)!;
  let mod = course.modules.find((m) => m.id === entry.data.module);
  if (!mod) {
    mod = { id: entry.data.module, title: entry.data.moduleTitle, order: entry.data.moduleOrder, lessons: [] };
    course.modules.push(mod);
  }
  const slug = entry.id.split("/").slice(1).join("/");
  mod.lessons.push({
    id: entry.id,
    lessonId: entry.data.lessonId,
    title: entry.data.title,
    href: `/courses/${cId}/${slug}`,
    order: entry.data.lessonOrder,
  });
}

// Sort modules and lessons
for (const course of courseMap.values()) {
  course.modules.sort((a, b) => a.order - b.order);
  for (const mod of course.modules) {
    mod.lessons.sort((a, b) => a.order - b.order);
  }
}

const courses = Array.from(courseMap.values());

const courseColorMap: Record<string, { badge: string; accent: string; icon: string }> = {
  red: {
    badge: "bg-rose-500/10 text-rose-400 border-rose-500/20",
    accent: "text-rose-400",
    icon: "bg-rose-500/15 text-rose-400",
  },
  blue: {
    badge: "bg-blue-500/10 text-blue-400 border-blue-500/20",
    accent: "text-blue-400",
    icon: "bg-blue-500/15 text-blue-400",
  },
  purple: {
    badge: "bg-purple-500/10 text-purple-400 border-purple-500/20",
    accent: "text-purple-400",
    icon: "bg-purple-500/15 text-purple-400",
  },
};

const courseIcons: Record<string, string> = {
  "angular-21": "NG",
  "typescript-6": "TS",
  "ai-engineer": "AI",
};

// Count total lessons per course
function courseTotal(course: CourseInfo) {
  return course.modules.reduce((sum, m) => sum + m.lessons.length, 0);
}
---

<aside
  id="sidebar"
  class="fixed lg:static inset-y-0 left-0 z-40 w-72 bg-zinc-950 border-r border-zinc-800/80 transform transition-transform lg:translate-x-0 -translate-x-full shrink-0"
>
  <div class="flex flex-col h-full">
    {/* Header */}
    <div class="px-4 py-5 border-b border-zinc-800/80">
      <a href="/" class="flex items-center gap-3 group">
        <div
          class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center shrink-0"
        >
          <svg
            class="w-4 h-4 text-white"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
            ></path>
          </svg>
        </div>
        <div>
          <h1 class="text-sm font-semibold text-white leading-none">
            Claude Code
          </h1>
          <p class="text-xs text-zinc-500 mt-0.5">Lab</p>
        </div>
      </a>
    </div>

    {/* Navigation */}
    <nav class="flex-1 overflow-y-auto sidebar-scroll px-2 py-3">
      {/* Search trigger */}
      <button
        id="search-trigger"
        class="w-full flex items-center gap-2 px-2.5 py-2 rounded-lg text-sm text-zinc-500 hover:text-zinc-300 hover:bg-zinc-800/50 transition-colors mb-3"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <span class="flex-1 text-left text-xs">Search...</span>
        <kbd class="text-[10px] text-zinc-600 bg-zinc-800 px-1.5 py-0.5 rounded"
          >⌘K</kbd
        >
      </button>

      {/* Quick links */}
      <div class="mb-3">
        <NavLink href="/reference" label="Reference" pathname={pathname} icon="book" />
        <NavLink href="/journal" label="Journal" pathname={pathname} icon="pencil" />
        <NavLink href="/templates" label="Templates" pathname={pathname} icon="template" />
        <NavLink href="/roadmap" label="Roadmap" pathname={pathname} icon="map" />
      </div>

      <div class="border-t border-zinc-800/60 pt-3">
        {/* My Courses heading */}
        <div class="flex items-center justify-between px-2 mb-2">
          <span class="text-[10px] font-semibold uppercase tracking-wider text-zinc-600">
            My Courses
          </span>
          <a href="/courses" class="text-[10px] text-zinc-600 hover:text-zinc-400 transition-colors">
            View all
          </a>
        </div>

        {/* Course list — always visible */}
        {courses.map((course) => {
          const isCourseActive = activeCourseId === course.id;
          const allCourseIds = course.modules.flatMap((m) => m.lessons.map((l) => l.lessonId));
          const colors = courseColorMap[course.color] || courseColorMap.purple;
          const icon = courseIcons[course.id] || "??";
          const total = courseTotal(course);

          return (
            <details class="mb-1.5" open={isCourseActive}>
              <summary
                class={`flex items-center gap-2.5 px-2.5 py-2 cursor-pointer list-none rounded-lg transition-colors ${
                  isCourseActive
                    ? "bg-zinc-800/60 text-white"
                    : "text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800/40"
                }`}
              >
                {/* Course icon badge */}
                <span class={`flex items-center justify-center w-7 h-7 rounded-md text-[10px] font-bold tracking-wide ${colors.icon}`}>
                  {icon}
                </span>
                <div class="flex-1 min-w-0">
                  <span class="block text-[13px] font-medium truncate">{course.title}</span>
                  <span class="block text-[10px] text-zinc-600">{total} lessons</span>
                </div>
                {/* Expand chevron */}
                <svg
                  class="w-3.5 h-3.5 text-zinc-600 shrink-0 transition-transform"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>

              {/* Modules + lessons tree */}
              <div class="mt-1 ml-2">
                {course.modules.map((mod) => {
                  const modLessonIds = mod.lessons.map((l) => l.lessonId);
                  const isModActive = mod.lessons.some((l) => pathname === l.href);
                  return (
                    <details class="mb-0.5" open={isModActive}>
                      <summary
                        class={`flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-left cursor-pointer list-none transition-colors ${
                          isModActive
                            ? "text-zinc-200 bg-zinc-800/40"
                            : "text-zinc-500 hover:text-zinc-300 hover:bg-zinc-800/30"
                        }`}
                      >
                        <svg
                          class="w-3 h-3 shrink-0 transition-transform"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="2.5"
                        >
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                        </svg>
                        <span class="truncate text-[12px]">{mod.title}</span>
                        <ModuleProgress client:load lessonIds={modLessonIds} />
                      </summary>

                      <div class="ml-4 pl-3 border-l border-zinc-800/60 mt-0.5 mb-1">
                        {mod.lessons.map((lesson) => (
                          <SidebarLesson
                            client:load
                            lessonId={lesson.lessonId}
                            href={lesson.href}
                            title={lesson.title}
                            isActive={pathname === lesson.href}
                            order={lesson.order}
                          />
                        ))}
                        <div class="px-2 py-0.5">
                          <ClearButton client:load lessonIds={modLessonIds} label={mod.title} />
                        </div>
                      </div>
                    </details>
                  );
                })}
                <div class="px-2 py-1">
                  <ClearButton client:load lessonIds={allCourseIds} label={course.title} />
                </div>
              </div>
            </details>
          );
        })}
      </div>
    </nav>

    {/* Footer */}
    <div class="px-4 py-3 border-t border-zinc-800/80">
      <form action="/api/logout" method="POST">
        <button
          type="submit"
          class="flex items-center gap-2 text-xs text-zinc-600 hover:text-zinc-400 transition-colors w-full"
        >
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
            ></path>
          </svg>
          Sign out
        </button>
      </form>
    </div>
  </div>
</aside>

{/* Mobile overlay */}
<div
  id="sidebar-overlay"
  class="lg:hidden fixed inset-0 bg-black/60 z-30 hidden"
>
</div>
