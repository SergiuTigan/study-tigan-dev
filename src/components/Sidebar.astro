---
import { getCollection } from "astro:content";
import NavLink from "./NavLink.astro";
import { SidebarLesson, ModuleProgress, ClearButton } from "./ProgressTracker";

const pathname = Astro.url.pathname;

// Load roadmap content for week nav
const allRoadmap = await getCollection("roadmap");
const weekIntros = allRoadmap
  .filter((e) => e.data.type === "week-intro")
  .sort((a, b) => a.data.order - b.data.order);

const days = allRoadmap
  .filter((e) => e.data.type === "day")
  .sort((a, b) => a.data.order - b.data.order);

// Group weeks by phase
const phases = new Map<number, typeof weekIntros>();
for (const week of weekIntros) {
  const p = week.data.phase;
  if (!phases.has(p)) phases.set(p, []);
  phases.get(p)!.push(week);
}

const phaseColors: Record<number, string> = {
  1: "bg-emerald-500/10 text-emerald-400 border-emerald-500/20",
  2: "bg-blue-500/10 text-blue-400 border-blue-500/20",
  3: "bg-purple-500/10 text-purple-400 border-purple-500/20",
  4: "bg-amber-500/10 text-amber-400 border-amber-500/20",
};

const phaseLabels: Record<number, string> = {
  1: "Foundations",
  2: "Deep Dive",
  3: "Production",
  4: "Portfolio",
};

function weekSlugFromId(id: string): string {
  return id.split("/")[0];
}

function daySlugFromId(id: string): string {
  return id.split("/")[1];
}

// ── Load courses for sidebar nav ─────────────────────────────────────
const allCourseLessons = await getCollection("courses");
const isCoursePage = pathname.startsWith("/courses");

// Detect which course is active (if any)
const courseMatch = pathname.match(/^\/courses\/([^/]+)/);
const activeCourseId = courseMatch?.[1] || null;

// Build course structure
interface CourseModule {
  id: string;
  title: string;
  order: number;
  lessons: { id: string; lessonId: string; title: string; href: string; order: number }[];
}

interface CourseInfo {
  id: string;
  title: string;
  color: string;
  modules: CourseModule[];
}

const courseMap = new Map<string, CourseInfo>();
for (const entry of allCourseLessons) {
  const cId = entry.data.course;
  if (!courseMap.has(cId)) {
    courseMap.set(cId, {
      id: cId,
      title: entry.data.courseTitle,
      color: entry.data.color,
      modules: [],
    });
  }
  const course = courseMap.get(cId)!;
  let mod = course.modules.find((m) => m.id === entry.data.module);
  if (!mod) {
    mod = { id: entry.data.module, title: entry.data.moduleTitle, order: entry.data.moduleOrder, lessons: [] };
    course.modules.push(mod);
  }
  const slug = entry.id.split("/").slice(1).join("/");
  mod.lessons.push({
    id: entry.id,
    lessonId: entry.data.lessonId,
    title: entry.data.title,
    href: `/courses/${cId}/${slug}`,
    order: entry.data.lessonOrder,
  });
}

// Sort modules and lessons
for (const course of courseMap.values()) {
  course.modules.sort((a, b) => a.order - b.order);
  for (const mod of course.modules) {
    mod.lessons.sort((a, b) => a.order - b.order);
  }
}

const courses = Array.from(courseMap.values());

const courseColorMap: Record<string, string> = {
  red: "bg-rose-500/10 text-rose-400 border-rose-500/20",
  blue: "bg-blue-500/10 text-blue-400 border-blue-500/20",
  purple: "bg-purple-500/10 text-purple-400 border-purple-500/20",
};
---

<aside
  id="sidebar"
  class="fixed lg:static inset-y-0 left-0 z-40 w-72 bg-zinc-950 border-r border-zinc-800/80 transform transition-transform lg:translate-x-0 -translate-x-full shrink-0"
>
  <div class="flex flex-col h-full">
    {/* Header */}
    <div class="px-4 py-5 border-b border-zinc-800/80">
      <a href="/" class="flex items-center gap-3 group">
        <div
          class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center shrink-0"
        >
          <svg
            class="w-4 h-4 text-white"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
            ></path>
          </svg>
        </div>
        <div>
          <h1 class="text-sm font-semibold text-white leading-none">
            Claude Code
          </h1>
          <p class="text-xs text-zinc-500 mt-0.5">Lab</p>
        </div>
      </a>
    </div>

    {/* Navigation */}
    <nav class="flex-1 overflow-y-auto sidebar-scroll px-2 py-3">
      {/* Search trigger */}
      <button
        id="search-trigger"
        class="w-full flex items-center gap-2 px-2.5 py-2 rounded-lg text-sm text-zinc-500 hover:text-zinc-300 hover:bg-zinc-800/50 transition-colors mb-3"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <span class="flex-1 text-left text-xs">Search...</span>
        <kbd class="text-[10px] text-zinc-600 bg-zinc-800 px-1.5 py-0.5 rounded"
          >⌘K</kbd
        >
      </button>

      {/* Main sections */}
      <div class="mb-4">
        <div class="px-2 mb-1.5">
          <span
            class="text-[10px] font-semibold uppercase tracking-wider text-zinc-600"
            >Sections</span
          >
        </div>
        <NavLink href="/reference" label="Reference" pathname={pathname} icon="book" />
        <NavLink href="/journal" label="Journal" pathname={pathname} icon="pencil" />
        <NavLink href="/templates" label="Templates" pathname={pathname} icon="template" />
        <NavLink href="/roadmap" label="Roadmap" pathname={pathname} icon="map" />
        <NavLink href="/courses" label="Courses" pathname={pathname} icon="courses" />
      </div>

      {/* Course modules/lessons (shown when on a course page) */}
      {isCoursePage && (
        <div class="border-t border-zinc-800/60 pt-3 mb-3">
          <div class="px-2 mb-1.5">
            <span class="text-[10px] font-semibold uppercase tracking-wider text-zinc-600">
              Courses
            </span>
          </div>
          {courses.map((course) => {
            const isCourseActive = activeCourseId === course.id;
            const allCourseIds = course.modules.flatMap((m) => m.lessons.map((l) => l.lessonId));
            return (
              <details class="mb-1" open={isCourseActive}>
                <summary
                  class={`flex items-center gap-2 px-2 py-1 mb-0.5 cursor-pointer list-none rounded-lg text-sm transition-colors ${
                    isCourseActive
                      ? "text-zinc-200"
                      : "text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800/50"
                  }`}
                >
                  <span class={`inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold uppercase tracking-wider border ${courseColorMap[course.color] || courseColorMap.purple}`}>
                    {course.id === "angular-21" ? "NG" : course.id === "typescript-6" ? "TS" : "AI"}
                  </span>
                  <span class="truncate text-[13px]">{course.title}</span>
                </summary>

                <div class="ml-1">
                  {course.modules.map((mod) => {
                    const modLessonIds = mod.lessons.map((l) => l.lessonId);
                    const isModActive = mod.lessons.some((l) => pathname === l.href);
                    return (
                      <details class="mb-0.5" open={isModActive}>
                        <summary
                          class={`flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-left cursor-pointer list-none text-sm transition-colors ${
                            isModActive
                              ? "text-zinc-200"
                              : "text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800/50"
                          }`}
                        >
                          <svg
                            class="w-3 h-3 shrink-0 transition-transform"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2.5"
                          >
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                          </svg>
                          <span class="truncate text-[13px]">{mod.title}</span>
                          <ModuleProgress client:load lessonIds={modLessonIds} />
                        </summary>

                        <div class="ml-5 pl-3 border-l border-zinc-800 mt-0.5 mb-1">
                          {mod.lessons.map((lesson) => (
                            <SidebarLesson
                              client:load
                              lessonId={lesson.lessonId}
                              href={lesson.href}
                              title={lesson.title}
                              isActive={pathname === lesson.href}
                              order={lesson.order}
                            />
                          ))}
                          <div class="px-2 py-1">
                            <ClearButton client:load lessonIds={modLessonIds} label={mod.title} />
                          </div>
                        </div>
                      </details>
                    );
                  })}
                  <div class="px-2 py-1 ml-1">
                    <ClearButton client:load lessonIds={allCourseIds} label={course.title} />
                  </div>
                </div>
              </details>
            );
          })}
        </div>
      )}

      {/* Roadmap weeks by phase */}
      <div class="border-t border-zinc-800/60 pt-3">
        {
          Array.from(phases.entries()).map(([phaseNum, phaseWeeks]) => (
            <details
              class="mb-2 group"
              open={phaseWeeks.some((w) =>
                pathname.includes(weekSlugFromId(w.id))
              )}
            >
              <summary class="px-2 mb-1 cursor-pointer list-none">
                <span
                  class={`inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold uppercase tracking-wider border ${phaseColors[phaseNum] || phaseColors[1]}`}
                >
                  Phase {phaseNum} &middot;{" "}
                  {phaseLabels[phaseNum]}
                </span>
              </summary>

              <div class="ml-1">
                {phaseWeeks.map((week) => {
                  const wSlug = weekSlugFromId(week.id);
                  const weekDays = days.filter(
                    (d) => d.data.week === week.data.week
                  );
                  const weekTitle = week.data.title
                    .replace(/^Week \d+[\s:—-]+/, "")
                    .trim();
                  const isWeekActive = pathname === `/roadmap/${wSlug}`;

                  return (
                    <details
                      class="mb-0.5"
                      open={pathname.includes(wSlug)}
                    >
                      <summary
                        class={`flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-left cursor-pointer list-none text-sm transition-colors ${
                          isWeekActive
                            ? "bg-indigo-500/10 text-indigo-400"
                            : "text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800/50"
                        }`}
                      >
                        <svg
                          class="w-3 h-3 shrink-0 transition-transform group-open:rotate-90"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="2.5"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M9 5l7 7-7 7"
                          />
                        </svg>
                        <span class="text-xs font-mono text-zinc-600 w-5 shrink-0">
                          {week.data.week
                            .toString()
                            .padStart(2, "0")}
                        </span>
                        <span class="truncate text-[13px]">
                          {weekTitle}
                        </span>
                      </summary>

                      <div class="ml-5 pl-3 border-l border-zinc-800 mt-0.5 mb-1">
                        <a
                          href={`/roadmap/${wSlug}`}
                          class={`block px-2 py-1 rounded text-xs transition-colors mb-0.5 ${
                            isWeekActive
                              ? "text-indigo-400 bg-indigo-500/10"
                              : "text-zinc-500 hover:text-zinc-300 hover:bg-zinc-800/50"
                          }`}
                        >
                          Week Overview
                        </a>
                        {weekDays.map((day) => {
                          const dSlug = daySlugFromId(day.id);
                          const isDayActive =
                            pathname ===
                            `/roadmap/${wSlug}/${dSlug}`;
                          const dayTitle = day.data.title
                            .replace(/^Day \d+[\s:—-]+/, "")
                            .trim();

                          return (
                            <a
                              href={`/roadmap/${wSlug}/${dSlug}`}
                              class={`block px-2 py-1 rounded text-xs transition-colors ${
                                isDayActive
                                  ? "text-indigo-400 bg-indigo-500/10"
                                  : "text-zinc-500 hover:text-zinc-300 hover:bg-zinc-800/50"
                              }`}
                            >
                              <span class="font-mono text-[10px] text-zinc-600 mr-1.5">
                                D{day.data.day}
                              </span>
                              <span class="truncate">
                                {dayTitle}
                              </span>
                            </a>
                          );
                        })}
                      </div>
                    </details>
                  );
                })}
              </div>
            </details>
          ))
        }
      </div>
    </nav>

    {/* Footer */}
    <div class="px-4 py-3 border-t border-zinc-800/80">
      <form action="/api/logout" method="POST">
        <button
          type="submit"
          class="flex items-center gap-2 text-xs text-zinc-600 hover:text-zinc-400 transition-colors w-full"
        >
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
            ></path>
          </svg>
          Sign out
        </button>
      </form>
    </div>
  </div>
</aside>

{/* Mobile overlay */}
<div
  id="sidebar-overlay"
  class="lg:hidden fixed inset-0 bg-black/60 z-30 hidden"
>
</div>
