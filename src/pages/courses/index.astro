---
import AppLayout from "../../layouts/AppLayout.astro";
import SearchDialog from "../../components/SearchDialog";
import { getCollection } from "astro:content";

const allLessons = await getCollection("courses");

// Group by course
const courseMap = new Map<
  string,
  { title: string; color: string; lessons: typeof allLessons; modules: Set<string> }
>();
for (const lesson of allLessons) {
  const key = lesson.data.course;
  if (!courseMap.has(key)) {
    courseMap.set(key, {
      title: lesson.data.courseTitle,
      color: lesson.data.color,
      lessons: [],
      modules: new Set(),
    });
  }
  const entry = courseMap.get(key)!;
  entry.lessons.push(lesson);
  entry.modules.add(lesson.data.module);
}

const courses = Array.from(courseMap.entries()).map(([id, data]) => ({
  id,
  title: data.title,
  color: data.color,
  lessonCount: data.lessons.length,
  moduleCount: data.modules.size,
}));

const colorStyles: Record<string, { bg: string; text: string; border: string; badge: string }> = {
  red: {
    bg: "bg-rose-500/5",
    text: "text-rose-400",
    border: "border-rose-500/20",
    badge: "bg-rose-500/10 text-rose-400",
  },
  blue: {
    bg: "bg-blue-500/5",
    text: "text-blue-400",
    border: "border-blue-500/20",
    badge: "bg-blue-500/10 text-blue-400",
  },
  purple: {
    bg: "bg-purple-500/5",
    text: "text-purple-400",
    border: "border-purple-500/20",
    badge: "bg-purple-500/10 text-purple-400",
  },
};

const courseIcons: Record<string, string> = {
  red: "M13 10V3L4 14h7v7l9-11h-7z",
  blue: "M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4",
  purple: "M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714a2.25 2.25 0 00.659 1.591L19 14.5M14.25 3.104c.251.023.501.05.75.082M19 14.5l-1.286-1.286a2.25 2.25 0 00-1.591-.659H7.877a2.25 2.25 0 00-1.591.659L5 14.5m14 0v3.75a2.25 2.25 0 01-2.25 2.25H7.25A2.25 2.25 0 015 18.25V14.5",
};
---

<AppLayout title="Courses">
  <div class="min-h-full">
    {/* Hero */}
    <div
      class="border-b border-zinc-800/80 bg-gradient-to-b from-zinc-900/50 to-transparent"
    >
      <div class="max-w-5xl mx-auto px-6 py-10 lg:py-14">
        <h1 class="text-2xl lg:text-3xl font-bold text-white tracking-tight">
          Courses
        </h1>
        <p class="text-zinc-400 mt-2 text-sm max-w-2xl">
          Structured, hands-on courses covering modern frameworks and AI
          engineering. Each course is organized into modules with focused lessons.
        </p>

        <div class="flex flex-wrap gap-6 mt-8">
          <div class="flex items-center gap-2">
            <div
              class="w-8 h-8 rounded-lg bg-indigo-500/10 flex items-center justify-center"
            >
              <svg
                class="w-4 h-4 text-indigo-400"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M4.26 10.147a60.438 60.438 0 00-.491 6.347A48.62 48.62 0 0112 20.904a48.62 48.62 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.636 50.636 0 00-2.658-.813A59.906 59.906 0 0112 3.493a59.903 59.903 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0112 13.489a50.702 50.702 0 017.74-3.342"
                ></path>
              </svg>
            </div>
            <div>
              <p class="text-lg font-semibold text-white">{courses.length}</p>
              <p class="text-xs text-zinc-500">Courses</p>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <div
              class="w-8 h-8 rounded-lg bg-indigo-500/10 flex items-center justify-center"
            >
              <svg
                class="w-4 h-4 text-indigo-400"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                ></path>
              </svg>
            </div>
            <div>
              <p class="text-lg font-semibold text-white">
                {allLessons.length}
              </p>
              <p class="text-xs text-zinc-500">Lessons</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* Course Cards */}
    <div class="max-w-5xl mx-auto px-6 py-10">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          courses.map((course) => {
            const c = colorStyles[course.color] || colorStyles.purple;
            const icon = courseIcons[course.color] || courseIcons.purple;
            return (
              <a
                href={`/courses/${course.id}`}
                class={`group block rounded-xl border ${c.border} ${c.bg} p-5 hover:border-zinc-700 transition-all hover:scale-[1.01]`}
              >
                <div class="flex items-start justify-between mb-3">
                  <div
                    class={`w-9 h-9 rounded-lg ${c.bg} flex items-center justify-center`}
                  >
                    <svg
                      class={`w-5 h-5 ${c.text}`}
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="1.5"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d={icon}
                      />
                    </svg>
                  </div>
                  <span class={`text-xs font-medium px-2 py-0.5 rounded-full ${c.badge}`}>
                    {course.lessonCount} lessons
                  </span>
                </div>
                <h3 class="text-sm font-semibold text-zinc-200 group-hover:text-white transition-colors">
                  {course.title}
                </h3>
                <p class="text-xs text-zinc-500 mt-1">
                  {course.moduleCount} modules
                </p>
              </a>
            );
          })
        }
      </div>
    </div>
  </div>
  <SearchDialog client:load />
</AppLayout>
