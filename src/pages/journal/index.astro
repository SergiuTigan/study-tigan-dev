---
import AppLayout from "../../layouts/AppLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import SearchDialog from "../../components/SearchDialog";
import { getCollection } from "astro:content";

const entries = (await getCollection("journal")).sort(
  (a, b) => b.data.date.localeCompare(a.data.date)
);
---

<AppLayout title="Journal">
  <div class="max-w-4xl mx-auto px-6 py-8 lg:py-12">
    <Breadcrumb items={[{ label: "Journal" }]} />
    <h1 class="text-2xl font-bold text-white tracking-tight mb-2">Journal</h1>
    <p class="text-zinc-400 text-sm mb-8">
      Daily notes, learnings, and observations.
    </p>

    <div class="space-y-3">
      {
        entries.map((entry) => (
          <a
            href={`/journal/${entry.id}`}
            class="block rounded-lg border border-zinc-800/60 bg-zinc-900/30 p-4 hover:border-zinc-700 transition-all group"
          >
            <div class="flex items-start justify-between gap-4">
              <div>
                <h3 class="text-sm font-medium text-zinc-200 group-hover:text-white transition-colors">
                  {entry.data.title}
                </h3>
                {entry.data.summary && (
                  <p class="text-xs text-zinc-500 mt-1">
                    {entry.data.summary}
                  </p>
                )}
                <div class="flex gap-2 mt-2">
                  {entry.data.tags.map((tag) => (
                    <span class="text-[10px] px-1.5 py-0.5 rounded bg-zinc-800 text-zinc-400">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
              <span class="text-xs text-zinc-600 font-mono shrink-0">
                {entry.data.date}
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
  <SearchDialog client:load />
</AppLayout>
