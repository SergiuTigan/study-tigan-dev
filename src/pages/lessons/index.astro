---
import AppLayout from "../../layouts/AppLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import SearchDialog from "../../components/SearchDialog";
import { getCollection } from "astro:content";

const entries = (await getCollection("lessons")).sort((a, b) =>
  b.data.date.localeCompare(a.data.date)
);
---

<AppLayout title="Lessons">
  <div class="max-w-4xl mx-auto px-6 py-8 lg:py-12">
    <Breadcrumb items={[{ label: "Lessons" }]} />
    <h1 class="text-2xl font-bold text-white tracking-tight mb-2">Lessons</h1>
    <p class="text-zinc-400 text-sm mb-8">
      Exercises and deeper reading from Alfred's daily lesson.
    </p>

    <div class="space-y-3">
      {
        entries.map((entry) => (
          <a
            href={`/lessons/${entry.id}`}
            class="block rounded-lg border border-zinc-800/60 bg-zinc-900/30 p-4 hover:border-zinc-700 transition-all group"
          >
            <div class="flex items-start justify-between gap-4">
              <div>
                <h3 class="text-sm font-medium text-zinc-200 group-hover:text-white transition-colors">
                  {entry.data.title}
                </h3>
                {entry.data.summary && (
                  <p class="text-xs text-zinc-500 mt-1">{entry.data.summary}</p>
                )}
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-zinc-800 text-zinc-400 inline-block mt-2">
                  {entry.data.category}
                </span>
              </div>
              <span class="text-xs text-zinc-600 font-mono shrink-0">
                {entry.data.date}
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
  <SearchDialog client:load />
</AppLayout>
