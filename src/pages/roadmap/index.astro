---
import AppLayout from "../../layouts/AppLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import PhaseHeader from "../../components/PhaseHeader.astro";
import SearchDialog from "../../components/SearchDialog";
import { getCollection } from "astro:content";

const allRoadmap = await getCollection("roadmap");
const weekIntros = allRoadmap
  .filter((e) => e.data.type === "week-intro")
  .sort((a, b) => a.data.order - b.data.order);
const days = allRoadmap.filter((e) => e.data.type === "day");

// Group weeks by phase
const phases = new Map<number, typeof weekIntros>();
for (const week of weekIntros) {
  const p = week.data.phase;
  if (!phases.has(p)) phases.set(p, []);
  phases.get(p)!.push(week);
}

const phaseIcons: Record<number, string> = {
  1: "M13 10V3L4 14h7v7l9-11h-7z",
  2: "M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z",
  3: "M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4",
  4: "M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
};

const phaseLabels: Record<number, string> = {
  1: "Foundations",
  2: "Deep Dive",
  3: "Production",
  4: "Portfolio",
};

const phaseBorders: Record<number, string> = {
  1: "border-emerald-500/20",
  2: "border-blue-500/20",
  3: "border-purple-500/20",
  4: "border-amber-500/20",
};

const phaseBgs: Record<number, string> = {
  1: "bg-emerald-500/5",
  2: "bg-blue-500/5",
  3: "bg-purple-500/5",
  4: "bg-amber-500/5",
};

function weekSlug(id: string) {
  return id.split("/")[0];
}
---

<AppLayout title="Roadmap">
  <div class="min-h-full">
    <div
      class="border-b border-zinc-800/80 bg-gradient-to-b from-zinc-900/50 to-transparent"
    >
      <div class="max-w-5xl mx-auto px-6 py-10 lg:py-14">
        <Breadcrumb items={[{ label: "Roadmap" }]} />
        <h1 class="text-2xl lg:text-3xl font-bold text-white tracking-tight">
          AI Engineer Roadmap
        </h1>
        <p class="text-zinc-400 mt-2 text-sm max-w-2xl">
          Structured, hands-on, project-driven. Weeks 1-12, 14-16.
        </p>
      </div>
    </div>

    <div class="max-w-5xl mx-auto px-6 py-10">
      {
        Array.from(phases.entries()).map(([phaseNum, phaseWeeks]) => (
          <div class="mb-12">
            <PhaseHeader
              phase={phaseNum}
              label={phaseLabels[phaseNum]}
              icon={phaseIcons[phaseNum]}
            />
            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {phaseWeeks.map((week) => {
                const wSlug = weekSlug(week.id);
                const weekDays = days.filter(
                  (d) => d.data.week === week.data.week
                );
                const weekTitle = week.data.title
                  .replace(/^Week \d+[\s:—-]+/, "")
                  .trim();

                return (
                  <a
                    href={`/roadmap/${wSlug}`}
                    class={`group block rounded-xl border ${phaseBorders[phaseNum]} ${phaseBgs[phaseNum]} p-4 hover:border-zinc-700 transition-all hover:scale-[1.01]`}
                  >
                    <div class="flex items-start justify-between">
                      <span class="text-xs font-mono text-zinc-600">
                        Week {week.data.week}
                      </span>
                      <span class="text-[10px] text-zinc-600 font-mono">
                        {weekDays.length} days
                      </span>
                    </div>
                    <h3 class="text-sm font-medium text-zinc-200 mt-2 group-hover:text-white transition-colors">
                      {weekTitle}
                    </h3>
                  </a>
                );
              })}
            </div>
          </div>
        ))
      }
    </div>
  </div>
  <SearchDialog client:load />
</AppLayout>
